{
  "name": "ng-guide",
  "version": "1.0.0",
  "description": "The Unofficial Georgian Angular Guide",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "eleventy --serve",
    "build": "eleventy",
    "diagrams": "node util/render-diagrams.js",
    "build:quiet": "eleventy --quiet",
    "preview": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "preinstall": "npx only-allow pnpm"
  },
  "author": "Pridon Tetradze",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "highlight.js": "^11.8.0",
    "luxon": "^3.4.4",
    "markdown-it": "^13.0.2",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-highlightjs": "^4.0.1",
    "mermaid": "^11.16.0",
    "pagefind": "^1.5.2",
    "puppeteer": "^25.4.0",
    "wrangler": "^4.114.0"
  }
}
