<header class="topbar">
  <div class="topbar__inner">
    <div class="topbar__left">
      <button
        class="iconbtn"
        id="menu-btn"
        type="button"
        aria-label="სარჩევის ჩვენება/დამალვა"
        aria-controls="sidenav"
        aria-expanded="true"
      >
        <svg width="17" height="12" viewBox="0 0 17 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="1" x2="16" y2="1"></line>
          <line x1="1" y1="6" x2="16" y2="6"></line>
          <line x1="1" y1="11" x2="16" y2="11"></line>
        </svg>
      </button>

      <a class="brand" href="/">
        <span>/angular-guide</span>
        <span class="brand__sep">&rsaquo;</span>
        <span class="brand__caret">_</span>
      </a>
    </div>

    <div class="topbar__right">
      <button class="searchpill" id="search-toggler" type="button" aria-label="ძებნა" aria-expanded="false">
        {% include "_search.njk" %}
        <span class="searchpill__label">ძებნა</span>
        <kbd>⌘K</kbd>
      </button>

      <a class="iconbtn" href="https://github.com/CondensedMilk7/ng-guide" aria-label="GitHub" rel="noopener">
        {% include "_github.njk" %}
      </a>

      <button class="iconbtn" id="theme-switch" type="button" aria-label="თემის გადართვა"></button>
    </div>
  </div>
</header>
