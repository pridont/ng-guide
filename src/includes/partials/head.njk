<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# `canonical` strips the `.html` Cloudflare redirects away — same url the
     sitemap lists. #}
  {%- set pageUrl = site.url + (page.url | canonical) %}
  {%- set pageDescription = description or site.description %}

  <title>{{ title }} - Angular Guide</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="color-scheme" content="dark light">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:image" content="{{ site.url }}/assets/cover.jpg">
  <meta property="og:description" content="{{ pageDescription }}">

  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="/assets/favicon-32x32.png">

  {#
    Loaded as a preload that promotes itself, so the third-party stylesheet and
    the woff2 chain behind it never block first paint. Text renders immediately
    in the metric-matched fallbacks declared in `tokens.css`, then swaps.
  #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Noto+Sans+Georgian:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Noto+Sans+Georgian:wght@400;500;600;700&display=swap"></noscript>

  {# Whole screen stylesheet, inlined — see `util/css-bundle.js`. #}
  <style>{% criticalCss %}</style>
  <link rel="stylesheet" href="/styles/print.css" media="print">

  {# Applied before first paint so the stored theme never flashes. #}
  <script>
    (function () {
      // Gates controls that only work with scripting, e.g. copy-to-clipboard.
      document.documentElement.dataset.js = "on";
      try {
        var stored = localStorage.getItem("theme");
        var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme =
          stored || (dark ? "dark" : "light");
      } catch (e) {
        document.documentElement.dataset.theme = "dark";
      }
    })();
  </script>

  {# Pagefind is 120 KB and most visits never search, so `main.js` pulls it in
     the first time the dialog is opened. #}
  <script type="module" src="/scripts/main.js"></script>
</head>
